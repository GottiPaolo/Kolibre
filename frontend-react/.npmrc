legacy-peer-deps=true

# Rete indulgente. Il build gira su una macchina in Wi-Fi e scarica ~493
# pacchetti: con i valori di default un singolo pacchetto lento fa fallire
# tutto `npm ci` e con esso l'intero deploy (successo il 18/09, exit 146
# dopo 139 secondi). Piu' tentativi e piu' pazienza costano nulla quando la
# rete va, e trasformano un inciampo di rete in qualche secondo in piu'
# invece che in un deploy da rifare.
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000
fetch-timeout=300000
