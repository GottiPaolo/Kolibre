# Copy this file to ".env" (never committed — it holds a password) and adjust
# the values. "docker compose up -d" reads them automatically.

# ── Ports exposed on the host machine ────────────────────────────────────
# Web interface:  http://<this-machine-address>:FRONTEND_PORT
# For the plugins (Calibre / KOReader / Obsidian): use BACKEND_PORT.
# The backend is told FRONTEND_PORT as well, so the Calibre plugin can build
# its "Open in Kolibre" link towards the real interface and not towards itself.
BACKEND_PORT=8081
FRONTEND_PORT=8080

# ── Persistent data ───────────────────────────────────────────────────────
# Host folder where Kolibre keeps libraries, databases, plugins and device
# backups. Created automatically on first start.
#
# BACK THIS FOLDER UP. It is the only thing that is not reproducible.
DATA_PATH=./kolibre-data

# ── First administrator ───────────────────────────────────────────────────
# Created automatically on the very first start, and only if no user exists
# yet — changing these afterwards has no effect. From then on, accounts are
# managed in Settings → People.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ── Security ──────────────────────────────────────────────────────────────
# Signs the access tokens (JWT). YOU CAN LEAVE THIS COMMENTED OUT: on first
# start Kolibre generates a random key and keeps it in DATA_PATH/secret_key,
# unique to your installation. Set it here only if you would rather manage it
# yourself — for instance to keep it in a secrets manager:
#
#   openssl rand -hex 32
#
# Example values and keys shorter than 16 characters are rejected: they would
# be known to anyone reading this file, and a known key lets anyone forge a
# valid token for any account.
#SECRET_KEY=

# ── Which origins may talk to this server ─────────────────────────────────
# By default only localhost, private networks (RFC1918) and .local names, on
# any port. Set this only if you reach Kolibre through a domain name or a
# reverse proxy:
#
#CORS_ORIGINS=https://kolibre.example.com

# ── Format conversion (optional) ──────────────────────────────────────────
# Path to Calibre's ebook-convert binary. If omitted it is detected
# automatically (PATH, /usr/bin, /opt/calibre, the macOS app bundle).
#KOLIBRE_EBOOK_CONVERT=/usr/bin/ebook-convert

# ── Version shown in Settings → System (optional) ─────────────────────────
# Set it to the release you are running, so that the interface and
# GET /api/kolibre/version can tell you what is actually deployed.
KOLIBRE_VERSION=1.0.0
